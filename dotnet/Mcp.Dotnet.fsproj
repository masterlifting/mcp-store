<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Mcp.Dotnet</RootNamespace>
    <AssemblyName>Mcp.Dotnet</AssemblyName>
    <OutputType>Exe</OutputType>
    <!-- Publish overrides these; declaring them here keeps an incremental plain
         Release build from reusing a portable-debug assembly during packaging. -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>3390;3391;3392;3393</WarningsAsErrors>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Budgets.fs" />
    <Compile Include="PathAuthorization.fs" />
    <Compile Include="Invocation.fs" />
    <Compile Include="ProcessRunner.fs" />
    <Compile Include="Parsers.fs" />
    <Compile Include="Artifacts.fs" />
    <Compile Include="DotnetService.fs" />
    <Compile Include="Host.fs" />
  </ItemGroup>
</Project>
