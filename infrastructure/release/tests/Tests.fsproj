<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Release.Tests</AssemblyName>
    <RootNamespace>Release.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixture.fs" />
    <Compile Include="Process.fs" />
    <Compile Include="Toolchain.fs" />
    <Compile Include="Snapshots.fs" />
    <Compile Include="Enrollment.fs" />
    <Compile Include="Coherence.fs" />
    <Compile Include="Compare.fs" />
    <Compile Include="Evaluate.fs" />
    <Compile Include="Historical.fs" />
    <Compile Include="Invocation.fs" />
    <Compile Include="Metadata.fs" />
    <Compile Include="Publish.fs" />
    <Compile Include="Integrity.fs" />
    <Compile Include="Policy.fs" />
    <Compile Include="Handoff.fs" />
    <Compile Include="Revision.fs" />
    <Compile Include="Runner.fs" />
    <Compile Include="Telegram.fs" />
    <Compile Include="Orchestration.fs" />
    <Compile Include="Authority.fs" />
    <Compile Include="Contract.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="$(ExpectoVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Release.fsproj" />
  </ItemGroup>
</Project>
