    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Archive.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Compare.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Metadata.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Publish.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Capture.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Enrollment.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Policy.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/PublisherClosure.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Handoff.fs", "kind": "compile" },
    { "from": "infrastructure/release/Release.fsproj", "to": "infrastructure/release/Evaluate.fs", "kind": "compile" },
